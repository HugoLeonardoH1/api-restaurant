{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "attributePosition": "auto"
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },

  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "expand": "always"
    }
  },

  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },

  "css": {
    "formatter": {
      "enabled": true
    }
  },

  "html": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "attributePosition": "auto",
      "bracketSameLine": false,
      "whitespaceSensitivity": "css"
    }
  }
}
